# Copie para "setup_federation/.env" e ajuste para o seu ambiente.
# O arquivo .env é ignorado pelo git e carregado automaticamente por
# todos os scripts de setup de federação.

# ===========================================================================
# HOMESERVERS PARTICIPANTES
# ===========================================================================

# Lista dos homeservers do teste (mínimo 2). Os nomes aqui são apenas
# rótulos internos, usados nos comandos (--only home01) e nos arquivos
# gerados (users_home01.csv).
FED_HOMESERVERS=home01,home02

# ---------------------------------------------------------------------------
# ATENÇÃO — a diferença entre URL e DOMAIN é a causa nº 1 de federação
# quebrada. Elas costumam SER DIFERENTES:
#
#   URL    = onde a API cliente responde (o que você põe no navegador /
#            no --host do Locust).            Ex.: https://srv.home01.exemplo.br
#
#   DOMAIN = o "server_name" configurado no homeserver.yaml do Synapse.
#            É o que aparece depois dos ":" no Matrix ID do usuário
#            (@fulano:home01.exemplo.br) e é o que vale para federação.
#                                             Ex.: home01.exemplo.br
#
# Como descobrir o DOMAIN correto com certeza:
#   curl -s https://SEU_SERVIDOR/_matrix/client/v3/login  # (confirma que a URL responde)
# e depois, após rodar o passo 3, confira a coluna user_id em tokens.csv:
# o que vier depois dos ":" é o server_name real. O passo 3 avisa se
# houver divergência com o que está configurado aqui.
#
# PREFIX = prefixo dos usernames desse homeserver. É por ele que os
#          scripts sabem a que servidor cada usuário pertence.
#          Precisa ser único por homeserver.
# ---------------------------------------------------------------------------

FED_HOME01_URL=https://srv.home01-stg.exemplo.br
FED_HOME01_DOMAIN=home01-stg.exemplo.br
FED_HOME01_PREFIX=userh01

FED_HOME02_URL=https://srv.home02-stg.exemplo.br
FED_HOME02_DOMAIN=home02-stg.exemplo.br
FED_HOME02_PREFIX=userh02

# Token de administrador do Synapse, usado APENAS pelo
# 99_cleanup_rooms.py no modo "purge". Deixe comentado se não for usar.
# FED_HOME01_ADMIN_TOKEN=syt_...
# FED_HOME02_ADMIN_TOKEN=syt_...

# ===========================================================================
# GERAÇÃO DE USUÁRIOS
# ===========================================================================

# Total de usuários, dividido igualmente entre os homeservers.
# Ex.: 1000 => 500 no home01 + 500 no home02.
NUM_USERS=1000

# ===========================================================================
# HTTP / TLS / PARALELISMO
# (mesmos parâmetros do setup de servidor único; ver setup/.env.example)
# ===========================================================================

# Em homologação com certificado autoassinado, use "false".
# Os scripts antigos da pasta federation/ usavam verify=False fixo no
# código; aqui isso virou uma decisão explícita e consciente.
VERIFY_TLS=true

HTTP_TIMEOUT=30
HTTP_RETRIES=3
HTTP_BACKOFF=0.5
REQUEST_SLEEP=0

# Threads simultâneas. A federação é mais pesada para o servidor que o
# cenário local; se aparecerem muitos 429/504, reduza este valor.
WORKERS=8

LOG_LEVEL=INFO

# ===========================================================================
# ARQUIVOS (os padrões já são compatíveis com o resto do projeto)
# ===========================================================================

# MATRIX_DATA_DIR=data/federation
# FED_EXPORTS_DIR=data/federation/exports
# USERS_CSV=data/federation/users.csv
# ROOMS_JSON=data/federation/rooms.json
# TOKENS_CSV=data/federation/tokens.csv
# ROOMS_STATUS_CSV=data/federation/rooms_status.csv
# FAILED_USERS_TXT=data/federation/failed_users.txt
