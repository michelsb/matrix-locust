# Copie este arquivo para ".env" (na mesma pasta "setup/") e ajuste os
# valores para o ambiente que será testado. O arquivo ".env" é ignorado
# pelo git (não deve ser versionado) e é carregado automaticamente por
# todos os scripts de setup.

# ---------------------------------------------------------------------------
# Servidor Matrix (obrigatório)
# ---------------------------------------------------------------------------

# URL base do homeserver que vai receber o teste de carga.
# Pode ser informado com ou sem o prefixo "https://".
MATRIX_SERVER=https://matrix.example.com

# Domínio (server_name) usado para montar os Matrix IDs (@usuario:dominio).
# Só é necessário definir se for diferente do host de MATRIX_SERVER
# (ex.: quando o homeserver está atrás de um proxy/CDN com outro domínio
# público, ou em testes federados com múltiplos domínios).
# MATRIX_DOMAIN=matrix.example.com

# ---------------------------------------------------------------------------
# TLS / HTTP
# ---------------------------------------------------------------------------

# Defina como "false" apenas em ambientes de teste com certificado
# autoassinado. NÃO desabilite em produção.
VERIFY_TLS=true

# Timeout (segundos) de cada requisição HTTP.
HTTP_TIMEOUT=30

# Número de tentativas automáticas em caso de erro transitório
# (HTTP 429/500/502/503/504).
HTTP_RETRIES=3

# Fator de backoff exponencial entre tentativas (segundos).
HTTP_BACKOFF=0.5

# Pausa (segundos) entre requisições sequenciais de um mesmo worker.
# Use um valor > 0 se o servidor tiver rate limiting agressivo.
REQUEST_SLEEP=0

# Número de threads usadas para paralelizar registro de usuários,
# criação de salas e aceite de convites.
WORKERS=8

# Nível de log: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Arquivos de dados gerados/consumidos pelos scripts
# (os padrões abaixo já são compatíveis com o restante do projeto
#  matrix-locust — normalmente não é necessário alterá-los)
# ---------------------------------------------------------------------------

# MATRIX_DATA_DIR=data/homeserver
# USERS_CSV=data/homeserver/users.csv
# ROOMS_JSON=data/homeserver/rooms.json
# TOKENS_CSV=data/homeserver/tokens.csv
# FAILED_USERS_TXT=data/homeserver/failed_users.txt
# ROOMS_STATUS_CSV=data/homeserver/rooms_status.csv

# ---------------------------------------------------------------------------
# Geração de usuários (setup/01_generate_users.py)
# ---------------------------------------------------------------------------

# Quantidade padrão de usuários a gerar quando o script é executado
# sem argumentos.
NUM_USERS=1000

# Domínios usados em testes federados (múltiplos homeservers).
# Formato: lista separada por vírgula. Deixe vazio para testes de um
# único servidor (usa MATRIX_DOMAIN/MATRIX_SERVER).
# USER_DOMAINS=matrix-a.example.com,matrix-b.example.com

# Pesos de distribuição correspondentes a USER_DOMAINS (mesma ordem,
# mesma quantidade de itens). Se omitido, a distribuição é uniforme.
# USER_DOMAIN_WEIGHTS=0.7,0.3
